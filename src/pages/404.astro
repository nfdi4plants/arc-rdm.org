---
import Layout from '../layouts/BaseLayout.astro';
---
<Layout title="Page not found" excludeFromSearch>
  <main class="site-container not-found">
    <p class="eyebrow">404 / Page not found</p>
    <h1>A missing connection.</h1>
    <p>This page does not exist, or its address has changed.<br />Head back to ARC or use search to find what you need.</p>
    <a class="button-primary" href="/">Back to ARC <span aria-hidden="true">→</span></a>
  </main>
</Layout>
<style>
  .not-found { padding-block: clamp(4rem, 10vw, 9rem); min-height: 55vh; }
  h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1.15; letter-spacing: -.05em; font-weight: 650; margin-block: 1rem 1.5rem; }
  .not-found > p:not(.eyebrow) { color: var(--site-muted); font-size: 1.05rem; margin-bottom: 2rem; }
</style>
