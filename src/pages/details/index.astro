---
import MarkdownLayout from '../../layouts/MarkdownLayout.astro';
import { knowledgeGroups } from '../../data/knowledge';

const frontmatter = {
  title: 'Learn ARC',
  description: 'Explore ARC annotation principles, workspaces, compilation, validation, and publication with RO-Crate.',
};
const headings = knowledgeGroups.map((group) => ({ depth: 2, slug: group.id, text: group.title }));
---

<MarkdownLayout frontmatter={frontmatter} headings={headings}>
  <p>ARC connects research data with the context needed to understand and reuse them. These articles explain its annotation principles, practical workspaces, and the path to publication.</p>
  <p>New to ARC? Start with <a href="/details/data-management-principle/">ARC and research data management</a>. Browse any topic from the sidebar as you read.</p>
  {knowledgeGroups.map((group) => (
    <section aria-labelledby={group.id}>
      <h2 id={group.id}>{group.title}</h2>
      <p>{group.description}</p>
      <p><a href={group.pages[0].href}>{group.pages[0].text}</a></p>
    </section>
  ))}
</MarkdownLayout>
