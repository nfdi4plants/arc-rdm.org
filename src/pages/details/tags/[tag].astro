---
import MarkdownLayout from '../../../layouts/MarkdownLayout.astro';
import type { MarkdownInstance } from 'astro';
import { canonicalTag } from '../../../lib/tags';

export async function getStaticPaths() {
  const allPosts = Object.values(import.meta.glob<MarkdownInstance<{ title: string; tags?: string[]; description?: string }>>([
    '../**/*.md',
    '../**/*.mdx',
    '../../dictionary/*.md',
  ], { eager: true }));

  const uniqueTags = [...new Set(allPosts.flatMap((post) => (post.frontmatter.tags ?? []).map(canonicalTag)))];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) => post.frontmatter.tags?.some((candidate) => canonicalTag(candidate) === tag));
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

---

<MarkdownLayout frontmatter={{title: "Tag: " + tag}}>
  <div class="w-full flex justify-center p-5 grow">
    <div class="prose xl:prose-xl grow">
      <p>All docs tagged with <em><strong>{tag}</strong></em>.</p>
      <ul>
        {posts.map((post) => <li>
          <a href={post.url}>{post.frontmatter.title}</a>
          <br />
          <div class="flex gap-2 opacity-75">
            {post.frontmatter.tags?.map((tag: string) =>
                <small>{tag}</small>
            )}
          </div>
          <div>
            {post.frontmatter.description}
          </div>
        </li>)}
      </ul>
    </div>
  </div>
</MarkdownLayout>
