---
import type { GetStaticPaths } from 'astro';
import { referenceRoutes, type ReferenceRoute } from '../data/reference';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReferenceLayout from '../layouts/ReferenceLayout.astro';

export const getStaticPaths = (() => referenceRoutes.map((entry) => ({
  params: { reference: entry.path.replace(/^\/|\/$/g, '') },
  props: { entry },
}))) satisfies GetStaticPaths;

interface Props {
  entry: ReferenceRoute;
}

const { entry } = Astro.props;
---

{entry.kind === 'redirect' ? (
  <BaseLayout title={entry.title} canonical={entry.target} excludeFromSearch>
    <Fragment slot="head">
      {entry.target.startsWith('https://') ? (
        <>
          <script is:inline define:vars={{ target: entry.target }}>
            const destination = new URL(target);
            if (window.location.hash) destination.hash = window.location.hash;
            window.location.replace(destination.href);
          </script>
          <noscript><meta http-equiv="refresh" content={`0;url=${entry.target}`} /></noscript>
        </>
      ) : (
        <meta http-equiv="refresh" content={`0;url=${entry.target}`} />
      )}
      <meta name="robots" content="noindex,follow" />
    </Fragment>
    <main id="main-content" class="site-container reference-redirect" data-pagefind-ignore="all">
      <h1>{entry.title}</h1>
      <p><a href={entry.target}>{entry.target.startsWith('https://') ? 'Read the specification' : 'Continue to the latest version'}</a></p>
    </main>
  </BaseLayout>
) : (
  <ReferenceLayout entry={entry} />
)}

<style>
  .reference-redirect { padding-top: 4rem; padding-bottom: 5rem; min-height: 60vh; }
  .reference-redirect h1 { font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1.15; letter-spacing: -.035em; }
  .reference-redirect p { margin-top: 1.5rem; }
  .reference-redirect a { color: var(--site-primary); text-decoration: underline; text-underline-offset: .2em; }
</style>
