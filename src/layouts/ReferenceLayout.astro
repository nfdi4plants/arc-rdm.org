---
import BaseLayout from './BaseLayout.astro';
import ContentLayout from './ContentLayout.astro';
import ContentNavigation from '../components/ContentNavigation.astro';
import OnThisPage from '../components/OnThisPage.astro';
import SpecificationDiagrams from '../components/SpecificationDiagrams.astro';
import { referenceNavigation, getReferenceBreadcrumbs, getReferencePid, type ReferenceRoute } from '../data/reference';
import { getSpecificationSourceUrl } from '../data/specifications';
import { renderSpecification } from '../lib/render-specification';

interface Props {
  entry: ReferenceRoute;
}

const { entry } = Astro.props;
const breadcrumbs = getReferenceBreadcrumbs(entry.path);
const pid = getReferencePid(entry.path);
const specification = entry.kind === 'page' ? entry.specification : undefined;
const rendered = specification ? await renderSpecification(specification) : undefined;
const toc = rendered?.headings.filter((heading) => heading.depth <= 3) ?? [];
---

<BaseLayout title={entry.title} description={`${entry.title} — specification reference.`} canonical={entry.path} excludeFromSearch>
  <ContentLayout navigationLabel="Browse reference pages">
    <ContentNavigation slot="navigation" title="Reference" links={referenceNavigation} currentPath={entry.path} />
    {toc.length > 0 && <OnThisPage slot="contents" headings={toc} />}
    <div class="reference-content">
      <nav class="reference-breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore="all">
        <ol>
          {breadcrumbs.map((crumb, index) => (
            <li>
              {index === breadcrumbs.length - 1
                ? <span aria-current="page">{crumb.text}</span>
                : <a href={crumb.href}>{crumb.text}</a>}
            </li>
          ))}
        </ol>
      </nav>
      <header class:list={{ 'specification-header': !!specification }}>
        {specification && <p class="eyebrow">Specification reference</p>}
        <h1 id={rendered?.titleId} data-pagefind-meta="title">{entry.title}</h1>
        {pid && <p class="reference-pid">Persistent identifier: <a href={pid}>{pid}</a></p>}
        {specification && <p class="reference-source"><a href={getSpecificationSourceUrl(specification)}>View this specification's source</a></p>}
      </header>
      {rendered && <article class="prose specification-body">
        {rendered.hasDiagrams
          ? <SpecificationDiagrams><div set:html={rendered.html} /></SpecificationDiagrams>
          : <div set:html={rendered.html} />}
      </article>}
    </div>
  </ContentLayout>
</BaseLayout>

<style>
  .reference-content { min-width: 0; padding-top: .15rem; }
  .reference-breadcrumbs ol { display: flex; align-items: baseline; flex-wrap: wrap; gap: .4rem .6rem; margin: 0 0 2.5rem; padding: 0; list-style: none; font-size: .8125rem; color: var(--site-muted); }
  .reference-breadcrumbs li { display: flex; align-items: baseline; gap: .6rem; }
  .reference-breadcrumbs li + li::before { content: '/'; color: var(--site-muted); opacity: .6; }
  .reference-breadcrumbs a { color: var(--site-muted); text-decoration: none; }
  .reference-breadcrumbs a:hover { color: var(--site-primary); text-decoration: underline; }
  h1 { max-width: 22ch; margin: 0; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 650; line-height: 1.12; letter-spacing: -.035em; overflow-wrap: anywhere; }
  .reference-pid { margin: 1.5rem 0 0; color: var(--site-muted); font-size: .875rem; line-height: 1.7; overflow-wrap: anywhere; }
  .reference-pid a { color: var(--site-primary); text-underline-offset: .2em; }
  .specification-header { padding-bottom: 1.75rem; border-bottom: 1px solid var(--site-border); }
  .specification-header .eyebrow { margin-bottom: 1rem; }
  .reference-source { margin: .65rem 0 0; font-size: .8125rem; }
  .reference-source a { color: var(--site-primary); text-underline-offset: .2em; }
  .specification-body { max-width: none; margin-top: 2rem; overflow-wrap: anywhere; }
  .specification-body :global(h2), .specification-body :global(h3), .specification-body :global(h4), .specification-body :global(h5), .specification-body :global(h6) { scroll-margin-top: 6rem; }
  .specification-body :global(.specification-anchor) { scroll-margin-top: 6rem; }
  .specification-body :global(img) { max-width: 100%; height: auto; }
  .specification-body :global(pre) { max-width: 100%; overflow-x: auto; }
  .specification-body :global(.specification-table) { max-width: 100%; overflow-x: auto; margin-block: 1.5rem; }
  .specification-body :global(.specification-table table) { display: table; overflow: visible; margin: 0; }
  .specification-body :global(.specification-table th), .specification-body :global(.specification-table td) { min-width: 7rem; }
  .specification-body :global(.specification-diagram) { margin: 2rem 0; padding: 1rem; border: 1px solid var(--site-border); border-radius: .5rem; }
  .specification-body :global([data-mermaid-output]) { overflow-x: auto; text-align: center; }
  .specification-body :global([data-mermaid-output] svg) { max-width: 100%; height: auto; margin-inline: auto; }
  .specification-body :global(.specification-diagram details) { margin-top: .75rem; }
  .specification-body :global(.specification-diagram summary) { color: var(--site-muted); font-size: .8125rem; cursor: pointer; }
  .specification-body :global([data-mermaid-error]) { color: var(--site-muted); font-size: .875rem; }
  .specification-body :global([data-mermaid-error][hidden]) { display: none; }
  @media (max-width: 899px) {
    .reference-content { min-height: 25vh; }
    .reference-breadcrumbs ol { margin-bottom: 2rem; }
  }
</style>
