---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { logoUrls } from '../data/branding';
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  excludeFromSearch?: boolean;
  drawerIsOpen?: boolean;
}
const {
  title,
  description = 'The Annotated Research Context is a framework for organizing and documenting research data.',
  canonical = Astro.url.pathname,
  excludeFromSearch = false,
} = Astro.props;
const canonicalURL = new URL(canonical, Astro.site ?? 'https://arc-rdm.org');
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#007b6d" />
    <link rel="icon" type="image/svg+xml" href={logoUrls.arc.light} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{'ARC | ' + title}</title>
    <script is:inline>
      (() => {
        let theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch { /* System preference works when storage is disabled. */ }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#site-content">Skip to content</a>
    <div class="site-shell">
      <Navbar />
      <div id="site-content" class="site-content" tabindex="-1" data-pagefind-body={!excludeFromSearch ? true : undefined} data-pagefind-ignore={excludeFromSearch ? 'all' : undefined}>
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>
