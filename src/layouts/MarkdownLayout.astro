---
import { URLS } from '../statics';
import Layout from './BaseLayout.astro';
import { canonicalTag } from '../lib/tags';
import KnowledgeNavigation from '../components/KnowledgeNavigation.astro';
import { getKnowledgeContext } from '../data/knowledge';
export interface Heading { depth: number; slug: string; text: string; }
interface Props {
  frontmatter: { title: string; description?: string; tags?: string[]; [key: string]: unknown };
  headings?: Heading[];
}
const { frontmatter, headings = [] } = Astro.props;
const minDepth = Math.min(...headings.map((heading) => heading.depth), 2);
const toc = headings.filter((heading) => heading.depth <= minDepth + 2);
const { group, parent, previous, next } = getKnowledgeContext(Astro.url.pathname);
const isKnowledge = Astro.url.pathname.startsWith('/details/');
---
<Layout title={frontmatter.title} description={frontmatter.description}>
  <main id="main-content" class="site-container article-layout">
    {group && <details class="mobile-knowledge" data-pagefind-ignore="all">
      <summary>Browse this section</summary>
      <KnowledgeNavigation group={group} />
    </details>}
    {toc.length > 0 && <details class="mobile-contents" data-pagefind-ignore="all">
      <summary>On this page</summary>
      <nav aria-label="On this page">
        <ul>{toc.map((heading) => <li style={{ paddingLeft: (heading.depth - minDepth) * .75 + 'rem' }}><a href={'#' + heading.slug}>{heading.text.replace(/^#/, '')}</a></li>)}</ul>
      </nav>
    </details>}
    <article class="prose article-content">
      <header class="article-header">
        {isKnowledge && <nav class="knowledge-breadcrumbs not-prose" aria-label="Knowledge breadcrumb" data-pagefind-ignore="all">
          <ol>
            <li><a href="/details/">Learn ARC</a></li>
            {group && <li><a href={`/details/#${group.id}`}>{group.title}</a></li>}
            {parent && <li><a href={parent.href}>{parent.text}</a></li>}
            <li aria-current="page">{frontmatter.title}</li>
          </ol>
        </nav>}
        <p class="eyebrow intro-marker" data-pagefind-ignore>ARC knowledge</p>
        <h1>{frontmatter.title}</h1>
        {frontmatter.tags?.length && <ul class="article-tags not-prose" aria-label="Topics" data-pagefind-ignore>
          {frontmatter.tags.map((tag) => <li><a href={URLS.INTERNAL_TAGS + '/' + encodeURIComponent(canonicalTag(tag))}>{tag}</a></li>)}
        </ul>}
      </header>
      <div id="md-content"><slot /></div>
      {(previous || next) && <nav class="article-pagination not-prose" aria-label="Article navigation" data-pagefind-ignore="all">
        {previous && <a href={previous.href} rel="prev"><span>Previous</span><strong>{previous.text}</strong></a>}
        {next && <a class="next-article" href={next.href} rel="next"><span>Next</span><strong>{next.text}</strong></a>}
      </nav>}
    </article>
    {(group || toc.length > 0) && <aside class="article-contents" data-pagefind-ignore="all">
      {group && <KnowledgeNavigation group={group} />}
      {toc.length > 0 && <nav class="page-contents" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <ul>{toc.map((heading) => <li style={{ paddingLeft: (heading.depth - minDepth) * .75 + 'rem' }}>
          <a href={'#' + heading.slug} data-heading={heading.slug}>{heading.text.replace(/^#/, '')}</a>
        </li>)}</ul>
      </nav>}
    </aside>}
  </main>
</Layout>
<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.article-contents a[data-heading]'));
  const headings = links.map((link) => document.getElementById(link.dataset.heading!)).filter((heading): heading is HTMLElement => !!heading);
  if (headings.length) {
    let scheduled = false;
    const update = () => {
      let current = headings[0];
      for (const heading of headings) { if (heading.getBoundingClientRect().top <= 130) current = heading; }
      links.forEach((link) => {
        if (link.dataset.heading === current.id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      scheduled = false;
    };
    update();
    window.addEventListener('scroll', () => { if (!scheduled) { scheduled = true; requestAnimationFrame(update); } }, { passive: true });
  }
</script>
<style>
  .article-layout { display: grid; grid-template-columns: minmax(0, 1fr) 235px; gap: clamp(2rem, 6vw, 6rem); align-items: start; padding-block: 3.5rem 4rem; }
  .article-content { width: 100%; min-width: 0; font-size: 1.02rem; }
  .article-header { margin-bottom: 2.5rem; padding-bottom: 1.75rem; border-bottom: 1px solid var(--site-border); }
  .knowledge-breadcrumbs ol { display: flex; align-items: baseline; flex-wrap: wrap; gap: .4rem .6rem; margin: 0 0 1.5rem; padding: 0; list-style: none; font-size: .78rem; color: var(--site-muted); }
  .knowledge-breadcrumbs li { display: flex; gap: .6rem; }
  .knowledge-breadcrumbs li + li::before { content: '/'; }
  .knowledge-breadcrumbs a { color: var(--site-primary); text-decoration: none; }
  .knowledge-breadcrumbs a:hover { text-decoration: underline; }
  .article-header .eyebrow { margin: 0 0 1rem; }
  .article-header h1 { margin: 0 0 1.25rem; }
  .article-tags { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; }
  .article-tags a { display: inline-block; font-size: .72rem; color: var(--site-primary); background: var(--site-soft); padding: .25rem .6rem; border-radius: .2rem; text-decoration: none; }
  .article-tags a:hover { text-decoration: underline; }
  .article-contents { position: sticky; top: 7.5rem; max-height: calc(100dvh - 9rem); overflow-y: auto; }
  .page-contents { margin-top: 1.75rem; }
  .page-contents:first-child { margin-top: 0; }
  .article-contents .eyebrow { margin-bottom: 1.1rem; font-size: .65rem; }
  .article-contents ul, .mobile-contents ul { list-style: none; padding: 0; margin: 0; }
  .article-contents ul { border-left: 1px solid var(--site-border); }
  .article-contents a, .mobile-contents a { display: block; padding: .45rem .8rem; color: var(--site-muted); font-size: .78rem; line-height: 1.5; text-decoration: none; }
  .article-contents a:hover, .article-contents a[aria-current] { color: var(--site-primary); background: var(--site-soft); }
  .mobile-contents { display: none; padding: .8rem 1rem; border: 1px solid var(--site-border); border-radius: .4rem; font-size: .85rem; }
  .mobile-contents summary { font-weight: 600; }
  .mobile-contents nav { margin-top: .7rem; }
  .mobile-knowledge { display: none; padding: .8rem 1rem; border: 1px solid var(--site-border); border-radius: .4rem; font-size: .85rem; }
  .mobile-knowledge summary { font-weight: 600; }
  .mobile-knowledge :global(.knowledge-navigation) { margin-top: 1rem; }
  .article-pagination { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 3rem; }
  .article-pagination a { display: flex; flex-direction: column; justify-content: center; min-height: 5rem; padding: 1rem; border: 1px solid var(--site-border); border-radius: .4rem; text-decoration: none; }
  .article-pagination a:hover { border-color: var(--site-primary); background: var(--site-soft); }
  .article-pagination span { color: var(--site-muted); font-size: .75rem; }
  .article-pagination strong { color: var(--site-primary); font-size: .9rem; font-weight: 600; line-height: 1.5; }
  .next-article { grid-column: 2; text-align: right; }
  @media (max-width: 900px) {
    .article-layout { display: flex; flex-direction: column; gap: 2rem; padding-block: 2rem; }
    .article-contents { display: none; }
    .mobile-contents { display: block; width: 100%; }
    .mobile-knowledge { display: block; width: 100%; }
    .article-content { max-width: 70ch; margin-inline: auto; font-size: 1rem; }
  }
  @media (max-width: 480px) { .article-pagination { grid-template-columns: 1fr; } .next-article { grid-column: 1; } }
</style>
