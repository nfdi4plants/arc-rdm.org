---
import MarkdownLayout from './MarkdownLayout.astro';
import ToolComponent from '../components/ToolComponent.astro';
import { toolGroups, type ToolMetadata } from '../data/tools';
import type { MarkdownInstance } from 'astro';

const files = import.meta.glob<MarkdownInstance<ToolMetadata>>('../pages/details/tools-and-services/*.md', { eager: true });
const { frontmatter, headings = [] } = Astro.props;
const toolHeadings = toolGroups.flatMap(({ category, tools }) => [
  { depth: 2, text: category, slug: category },
  ...tools.map(({ metadata }) => ({ depth: 3, text: metadata.title, slug: metadata.slug })),
]);
---

<MarkdownLayout frontmatter={frontmatter} headings={[...headings, ...toolHeadings]}>
  <slot />
  {toolGroups.map(({ category, tools }) => (
    <section aria-label={category}>
      <h2 id={category} class="anchor"><a href={'#' + category} class="anchor-link">#</a>{category}</h2>
      {tools.map((tool) => (
        <ToolComponent toolProps={files[tool.source].frontmatter} html={files[tool.source].compiledContent()} />
      ))}
    </section>
  ))}
</MarkdownLayout>
