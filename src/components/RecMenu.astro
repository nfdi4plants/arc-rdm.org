---
export interface Link { href?: string; text: string; children?: Link[]; }
interface Props { links: Link[]; className?: string | string[]; isOpen?: boolean; }
const { links, className } = Astro.props;
const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const current = normalize(Astro.url.pathname);
---
<ul class:list={['navigation-tree', className]}>
  {links.map((link) => (
    <li>
      {link.href ? <a href={link.href} aria-current={current === normalize(link.href) ? 'page' : undefined}>{link.text}</a> : <span class="group-label">{link.text}</span>}
      {link.children?.length && <Astro.self links={link.children} />}
    </li>
  ))}
</ul>
<style>
  .navigation-tree { list-style: none; margin: 0; padding: 0; }
  .navigation-tree a, .group-label { display: block; padding: .45rem .65rem; font-size: .83rem; line-height: 1.45; border-radius: .3rem; }
  .navigation-tree a { color: var(--site-ink); text-decoration: none; }
  .navigation-tree a:hover, .navigation-tree a[aria-current="page"] { color: var(--site-primary); background: var(--site-soft); }
  .group-label { font-weight: 650; color: var(--site-muted); }
  .navigation-tree :global(.navigation-tree) { margin: .15rem 0 .4rem .7rem; border-left: 1px solid var(--site-border); padding-left: .4rem; }
</style>
