---
import '@pagefind/default-ui/css/ui.css';
---
<button id="open-search" class="search-trigger" type="button" aria-label="Search the ARC website" aria-keyshortcuts="s" title="Search (S)" aria-haspopup="dialog" aria-controls="search-dialog">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
  <span>Search</span>
</button>
<dialog id="search-dialog" aria-labelledby="search-title">
  <div class="search-dialog-heading">
    <h2 id="search-title">Search ARC</h2>
    <button id="close-search" type="button" aria-label="Close search" title="Close search (Esc)">Close</button>
  </div>
  <p id="search-status" role="status">Loading search…</p>
  <div id="site-search"></div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#search-dialog');
  const trigger = document.querySelector<HTMLButtonElement>('#open-search');
  const status = document.querySelector<HTMLElement>('#search-status');
  let ready: Promise<void> | undefined;
  let returnFocus: HTMLElement | null = null;

  async function openSearch() {
    if (!dialog || dialog.open) return;
    returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : trigger;
    dialog.showModal();
    document.documentElement.classList.add('search-open');
    try {
      ready ??= import('@pagefind/default-ui').then(({ PagefindUI }) => {
        new PagefindUI({ element: '#site-search', bundlePath: '/pagefind/', showImages: false, showSubResults: true, resetStyles: false });
        if (status) status.hidden = true;
      });
      await ready;
      if (dialog.open) requestAnimationFrame(() => dialog.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.focus());
    } catch {
      ready = undefined;
      if (status) { status.hidden = false; status.textContent = 'Search could not load. Close this window and try again.'; }
    }
  }
  trigger?.addEventListener('click', openSearch);
  document.querySelector('#close-search')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('close', () => {
    document.documentElement.classList.remove('search-open');
    returnFocus?.focus();
  });
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  document.addEventListener('keydown', (event) => {
    const target = event.target;
    const editing = target instanceof HTMLElement && (target.isContentEditable || !!target.closest('input, textarea, select, [role="textbox"]'));
    if (event.key.toLowerCase() === 's' && !editing && !event.ctrlKey && !event.metaKey && !event.altKey && !dialog?.open) {
      event.preventDefault();
      void openSearch();
    }
  });
</script>
<style>
  .search-trigger { display: inline-flex; align-items: center; gap: .5rem; min-height: 40px; padding: .45rem .6rem; color: var(--site-muted); border-radius: .35rem; font-size: .8rem; }
  .search-trigger:hover { color: var(--site-ink); background: var(--site-soft); }
  dialog { color: var(--site-ink); background: var(--site-surface); border: 1px solid var(--site-border); border-radius: .8rem; padding: 0; margin: 8dvh auto auto; width: min(720px, calc(100vw - 2rem)); max-height: 84dvh; overflow-y: auto; overscroll-behavior: contain; box-shadow: 0 24px 80px #0003; }
  dialog::backdrop { background: #0a211bb3; backdrop-filter: blur(3px); }
  .search-dialog-heading { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--site-border); }
  h2 { font-size: 1rem; font-weight: 650; }
  #close-search { display: flex; align-items: center; gap: .6rem; font-size: .8rem; color: var(--site-muted); padding: .35rem; }
  #search-status { padding: 1.5rem; color: var(--site-muted); font-size: .9rem; }
  #site-search { padding: 1.5rem; }
  @media (max-width: 640px) { .search-trigger { padding: .5rem; } .search-trigger span { display: none; } dialog { margin-top: 1rem; max-height: calc(100dvh - 2rem); } #site-search { padding: 1rem; } }
</style>
<style is:global>
  html.search-open { overflow: hidden; }
  #site-search {
    --pagefind-ui-scale: .85;
    --pagefind-ui-primary: var(--site-primary);
    --pagefind-ui-text: var(--site-ink);
    --pagefind-ui-background: var(--site-surface);
    --pagefind-ui-border: var(--site-border);
    --pagefind-ui-tag: var(--site-soft);
    --pagefind-ui-border-radius: 5px;
    --pagefind-ui-font: inherit;
  }
  #site-search .pagefind-ui__search-input { font-weight: 400; }
  #site-search .pagefind-ui__search-input:focus-visible { outline: 2px solid var(--site-primary); outline-offset: 2px; }
  #site-search .pagefind-ui__result-link { color: var(--site-primary); }
  #site-search mark { background: #00a89630; color: inherit; }
</style>
