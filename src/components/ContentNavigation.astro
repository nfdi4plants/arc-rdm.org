---
import RecMenu, { type Link } from './RecMenu.astro';

interface Props {
  title: string;
  label?: string;
  links: Link[];
  currentPath?: string;
  backLink?: { href: string; text: string };
}

const { title, label = title, links, currentPath = Astro.url.pathname, backLink } = Astro.props;
---

<nav class="content-navigation" aria-label={label} data-pagefind-ignore="all">
  {backLink && <a class="back-link" href={backLink.href}>{backLink.text}</a>}
  <p class="eyebrow">{title}</p>
  <RecMenu links={links} currentPath={currentPath} />
</nav>

<style>
  .back-link { display: inline-block; margin-bottom: 1.25rem; color: var(--site-primary); font-size: .8rem; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  .eyebrow { margin: 0 0 .8rem; padding-inline: .65rem; font-size: .65rem; }
</style>
