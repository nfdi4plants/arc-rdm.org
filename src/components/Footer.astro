---
import { URLS } from '../statics';
---
<footer class="site-footer" data-pagefind-ignore="all">
  <div class="site-container footer-inner">
    <div class="footer-identity">
      <a href="/" class="footer-brand">ARC<span class="brand-dot">.</span></a>
      <p>Research data. In context.</p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href={URLS.INTERNAL_TOOLS}>Tools & services</a>
      <a href={URLS.INTERNAL_COM_RESOURCES}>Resources</a>
      <a href={URLS.INTERNAL_PARTNERS}>Partners</a>
      <a href={URLS.INTERNAL_DICTIONARY}>Dictionary</a>
      <a href={URLS.GITHUB_REPO}>GitHub <span aria-hidden="true">↗</span></a>
      <a href={URLS.DATAPLANT_WEBSITE}>DataPLANT <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
  <div class="site-container footer-bottom"><span>Annotated Research Context</span><span>An open framework for research data management</span></div>
</footer>
<style>
  .site-footer { margin-top: 3rem; background: var(--site-soft); border-top: 1px solid var(--site-border); }
  .footer-inner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding-block: 3rem; }
  .footer-brand { font-size: 1.8rem; font-weight: 750; letter-spacing: -.06em; color: var(--site-ink); text-decoration: none; }
  .brand-dot { color: var(--site-accent); }
  .footer-identity p { font-size: .85rem; color: var(--site-muted); margin-top: .35rem; }
  .footer-links { display: grid; grid-template-columns: repeat(3, auto); gap: .7rem 2.5rem; font-size: .8rem; }
  .footer-links a { color: var(--site-muted); text-decoration: none; }
  .footer-links a:hover { color: var(--site-primary); text-decoration: underline; text-underline-offset: .2em; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.1rem; border-top: 1px solid var(--site-border); font-size: .7rem; color: var(--site-muted); }
  @media (max-width: 640px) { .footer-inner { align-items: flex-start; flex-direction: column; padding-block: 2rem; } .footer-links { grid-template-columns: repeat(2, auto); } .footer-bottom { flex-direction: column; gap: .25rem; } }
</style>
