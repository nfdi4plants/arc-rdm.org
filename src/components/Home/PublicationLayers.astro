---
import ResearchIcon from '../ResearchIcon.astro';
import { logoUrls } from '../../data/branding';
---

<section class="publication-space" aria-labelledby="arc-publication-heading" aria-describedby="arc-publication-description">
  <div class="space-intro">
    <p class="space-label">Publication space</p>
    <p class="space-description" id="arc-publication-description">
      Your workspace is packaged as a <strong>FAIR Digital Object</strong>. ARC RO-Crate
      provides a common harmonizing publication layer that supports domain-specific descriptions.
    </p>
  </div>
  <div class="publication-object">
    <header class="publication-header">
      <h2 id="arc-publication-heading"><a href="/details/arc-ro-crate/">ARC RO-Crate <span aria-hidden="true">↗</span></a></h2>
      <span class="publication-logo">
        <img class="logo-light" src={logoUrls.roCrate.light} alt="RO-Crate logo" width="52" height="52" />
        <img class="logo-dark" src={logoUrls.roCrate.dark} alt="RO-Crate logo" width="52" height="52" />
      </span>
    </header>
    <div class="publication-layers" role="group" aria-label="Research data within one shared core-profile layer, surrounded by domain-specific profiles and then persistent identifiers">
      <div class="identifier-layer">
        <a class="layer-label identifier-label" href="/details/exchange-and-publication/">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m10 13 4-4m-6 6-1 1a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0m2 2 1-1a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0" /></svg>
          <strong>Persistent identifiers</strong>
          <span class="link-arrow" aria-hidden="true">↗</span>
        </a>
        <div class="domain-layer">
          <a class="layer-label domain-label" href="/details/arc-ro-crate/#connected-research-context"><ResearchIcon icon="domain" /><strong>Domain-specific profiles</strong><span class="link-arrow" aria-hidden="true">↗</span></a>
          <div class="profiles-layer" role="group" aria-label="Three complementary core profiles">
            <a class="profile-box administrative-profile" href="/details/arc-ro-crate/#administrative-core">
              <span class="profile-icon"><ResearchIcon icon="administrative" /></span>
              <span class="profile-copy"><strong>Administrative</strong> <span>Core Profile</span></span>
              <span class="link-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="profile-box provenance-profile" href="/details/arc-ro-crate/#provenance-core">
              <span class="profile-icon"><ResearchIcon icon="provenance" /></span>
              <span class="profile-copy"><strong>Provenance</strong> <span>Core Profile</span></span>
              <span class="link-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="profile-box semantic-profile" href="/details/arc-ro-crate/#semantic-core">
              <span class="profile-icon"><ResearchIcon icon="semantic" /></span>
              <span class="profile-copy"><strong>Semantic</strong> <span>Core Profile</span></span>
              <span class="link-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="research-data">
              <ResearchIcon icon="data" />
              <strong>Research data</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .publication-space { display: grid; grid-template-rows: subgrid; grid-column: 3; grid-row: 1 / span 2; align-self: stretch; min-width: 0; }
  .space-intro { margin: 0 0 0 .15rem; }
  .space-label { margin: 0; color: var(--site-accent); font-size: .875rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .space-description { margin: .45rem 0 0; color: var(--site-muted); font-size: .85rem; line-height: 1.6; }
  .space-description strong { color: var(--site-accent); font-weight: 600; }
  /* Keep query containment off the subgrid so the description sizes the shared row. */
  /* Match the workspace surface's top padding and 1px border before the header. */
  .publication-object { container-type: inline-size; position: relative; width: 100%; margin: 0; padding-top: calc(1.25rem + 1px); }
  .publication-object::before { content: ''; position: absolute; inset: -.45rem; border: 1px solid var(--site-accent); border-radius: .8rem; pointer-events: none; }
  .publication-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.25rem; margin: 0 .9rem 1.1rem; }
  h2 { min-width: 0; margin: 0; font-size: clamp(1rem, 1.65vw, 1.35rem); font-weight: 650; letter-spacing: -.025em; line-height: 1.3; }
  h2 a { display: inline-flex; align-items: center; gap: .6rem; min-height: 44px; color: var(--site-ink); text-decoration: none; }
  h2 a:hover { text-decoration: underline; text-underline-offset: .2em; }
  h2 a > span { color: var(--site-accent); font-size: .8rem; font-weight: 400; }
  .publication-logo { display: block; flex: 0 0 52px; width: 52px; height: 52px; object-fit: contain; }
  .publication-logo img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .publication-logo .logo-dark { display: none; }
  :global([data-theme="dark"]) .publication-logo .logo-light { display: none; }
  :global([data-theme="dark"]) .publication-logo .logo-dark { display: block; }
  .identifier-layer { padding: .25rem .9rem .9rem; background: color-mix(in srgb, var(--site-accent) 7%, var(--site-surface)); border: 1px solid color-mix(in srgb, var(--site-accent) 45%, var(--site-surface)); border-radius: .65rem; box-shadow: 0 12px 30px rgb(0 50 43 / .04); }
  .domain-layer { padding: .25rem .75rem .75rem; background: color-mix(in srgb, var(--site-primary) 4%, var(--site-surface)); border: 1px solid color-mix(in srgb, var(--site-primary) 30%, var(--site-surface)); border-radius: .4rem; }
  .profiles-layer { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-areas: 'administrative administrative' 'data data' 'provenance semantic'; gap: .8rem 1rem; padding: .85rem; background: color-mix(in srgb, var(--site-primary) 12%, var(--site-surface)); border: 1px solid color-mix(in srgb, var(--site-primary) 45%, var(--site-surface)); border-radius: .4rem; }
  .profile-box { display: flex; align-items: center; justify-content: center; gap: .5rem; min-width: 0; min-height: 3.2rem; padding: .45rem .3rem; color: var(--site-ink); background: var(--site-surface); border: 1px solid color-mix(in srgb, var(--site-primary) 40%, var(--site-surface)); border-radius: .4rem; text-align: left; text-decoration: none; line-height: 1.35; }
  .profile-copy { display: flex; flex-direction: column; gap: .1rem; min-width: 0; }
  .profile-box strong { font-size: .8rem; font-weight: 650; }
  .profile-copy > span { font-size: .65rem; color: var(--site-muted); }
  .profile-icon { display: grid; place-items: center; flex-shrink: 0; width: 1.6rem; height: 1.6rem; color: var(--site-primary); background: var(--site-soft); border-radius: .3rem; }
  .profile-box:hover { border-color: var(--site-primary); }
  .profile-box:hover strong { text-decoration: underline; text-underline-offset: .2em; }
  .link-arrow { flex-shrink: 0; color: var(--site-primary); font-size: .95rem; font-weight: 400; line-height: 1; }
  .profile-box .link-arrow { margin-left: auto; }
  .administrative-profile { grid-area: administrative; justify-self: center; width: min(100%, 11rem); }
  .provenance-profile { grid-area: provenance; }
  .semantic-profile { grid-area: semantic; }
  .layer-label { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; column-gap: .35rem; min-height: 44px; padding: .4rem .1rem; color: var(--site-ink); font-size: .8rem; line-height: 1.3; text-align: center; text-decoration: none; }
  .layer-label strong { font-weight: 650; }
  .layer-label .link-arrow { color: inherit; }
  .layer-label:hover { text-decoration: underline; text-underline-offset: .2em; }
  .identifier-label { color: var(--site-accent); }
  .domain-label { color: var(--site-primary); }
  .identifier-label svg { flex-shrink: 0; width: 1rem; height: 1rem; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .research-data { grid-area: data; justify-self: center; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .3rem; width: min(100%, 8.5rem); aspect-ratio: 1; padding: .75rem .5rem; color: var(--site-surface); background: var(--site-primary); border-radius: .4rem; text-align: center; }
  .research-data strong { font-size: .95rem; font-weight: 650; line-height: 1.3; }
  @container (max-width: 24.5rem) {
    .profiles-layer { grid-template-areas: 'administrative administrative' 'data data' 'provenance provenance' 'semantic semantic'; }
    .profile-box { justify-self: center; width: min(100%, 11rem); }
  }
  @media (max-width: 900px) {
    .publication-space { display: flex; flex-direction: column; grid-column: auto; grid-row: auto; }
    .space-intro { margin-bottom: 1.1rem; }
  }
  @media (max-width: 420px) {
    .publication-object { padding-top: calc(.85rem + 1px); }
    .identifier-layer { padding-inline: .6rem; padding-bottom: .6rem; }
    .domain-layer { padding-inline: .45rem; padding-bottom: .45rem; }
    .profiles-layer { padding: .5rem; column-gap: .4rem; }
    .profile-box strong { font-size: .75rem; }
    .publication-header { margin-inline: .5rem; }
    .publication-logo { flex-basis: 44px; width: 44px; height: 44px; }
    .layer-label { column-gap: .25rem; }
  }
</style>
