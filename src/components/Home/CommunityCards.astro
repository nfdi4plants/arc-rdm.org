---
import { URLS } from '../../statics';
import AudienceSection from './AudienceSection.astro';

const cards = [
  { title: 'Start with your data', href: URLS.INTERNAL_COM_DATA_MANAGEMENT, description: 'Keep data connected to its contributors, the processes behind it, and its scientific meaning.' },
  { title: 'Find your tools', href: URLS.INTERNAL_TOOLS, description: 'Discover applications and services for organizing workspaces, annotating data, and sharing research.' },
  { title: 'Learn with the community', href: URLS.INTERNAL_COM_RESOURCES, description: 'Explore practical guides, educational videos, and publications from the community.' },
];
const links = [
  { title: 'Documentation', href: URLS.INTERNAL_COM_DOCUMENTATION },
  { title: 'Organization', href: URLS.INTERNAL_COM_ORGANIZATION },
  { title: 'Shared vocabulary', href: URLS.INTERNAL_COM_ONTOLOGY },
  { title: 'Publication & exchange', href: URLS.INTERNAL_COM_PUBLICATION },
  { title: 'RDM & FAIRness', href: URLS.INTERNAL_COM_FAIRNESS },
];
---

<AudienceSection
  id="FOR-THE-RESEARCH-COMMUNITY"
  number="01"
  audience="For the research community"
  heading="Good research starts with context."
  introduction="Keep the details that make your research understandable. Use a workspace suited to your research and build its context as your work evolves."
  cards={cards}
  links={links}
/>

