---
import ResearchFolder, { type FolderItem } from '../ResearchFolder.astro';

const workspaceItems: FolderItem[] = [
  { title: 'Research data', description: 'Measurements, files, and research outputs', icon: 'data' },
  { title: 'Administrative Metadata', description: 'Identity, contributors, and rights', icon: 'administrative', href: '/abstract-model/administrative-core/' },
  { title: 'Provenance Metadata', description: 'Processes, inputs, and outputs', icon: 'provenance', href: '/abstract-model/provenance-core/' },
  { title: 'Semantic Metadata', description: 'Meaning, units, and vocabulary', icon: 'semantic', href: '/abstract-model/semantic-core/' },
];
const publicationItems: FolderItem[] = [
  { title: 'Research data', description: 'Files and research outputs for sharing', icon: 'data' },
  { title: 'Administrative Core', description: 'Identity, contributors, and rights', icon: 'administrative', href: '/ro-crate/administrative-core/' },
  { title: 'Provenance Core', description: 'Processes, inputs, and outputs', icon: 'provenance', href: '/ro-crate/provenance-core/' },
  { title: 'Semantic Core', description: 'Meaning, units, and vocabulary', icon: 'semantic', href: '/ro-crate/semantic-core/' },
];
---

<figure class="workspace-figure">
  <div class="research-flow">
    <ResearchFolder
      id="arc-workspace" title="ARC Workspace" label="Workspace" href="/workspace/"
      logo={{ src: '/favicon.svg', alt: 'ARC logo' }} items={workspaceItems}
      caption="Data and metadata evolve together"
    />
    <div class="publication-transition">
      <span>Transform for publication</span>
      <svg viewBox="0 0 80 24" fill="none" aria-hidden="true"><path d="M2 12h74m-9-9 9 9-9 9" /></svg>
    </div>
    <ResearchFolder
      id="arc-publication" title="ARC RO-Crate" label="Publication space" href="/ro-crate/"
      logo={{ src: '/ro-crate-logo.svg', darkSrc: '/ro-crate-logo-dark.svg', alt: 'RO-Crate logo' }} items={publicationItems}
      caption="Research context packaged for reuse" packaged
    />
  </div>
  <figcaption>One research context, from evolving work to publication.<br />Workspace organization can vary; the three base profiles express its context in ARC RO-Crate.</figcaption>
</figure>

<style>
  .workspace-figure { min-width: 0; margin: 0; padding: clamp(1.1rem, 3vw, 2.25rem); background: var(--site-soft); border: 1px solid var(--site-border); border-radius: 1rem; }
  .research-flow { display: grid; grid-template-columns: minmax(0, 1fr) 7rem minmax(0, 1fr); align-items: center; gap: clamp(.8rem, 1.8vw, 1.5rem); }
  .publication-transition { display: flex; flex-direction: column; align-items: center; gap: .7rem; color: var(--site-accent); text-align: center; font-size: .72rem; font-weight: 600; line-height: 1.5; }
  .publication-transition svg { width: 4rem; height: 1.5rem; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  figcaption { margin-top: 1.9rem; color: var(--site-muted); text-align: center; font-size: .75rem; line-height: 1.7; }
  @media (max-width: 900px) {
    .workspace-figure { width: min(100%, 36rem); justify-self: center; }
    .research-flow { grid-template-columns: minmax(0, 1fr); gap: 1.6rem; }
    .publication-transition { flex-direction: row; justify-content: center; gap: .4rem; }
    .publication-transition svg { order: -1; width: 2.5rem; transform: rotate(90deg); }
    figcaption { margin-top: 1.5rem; }
  }
</style>
