---
import { URLS } from '../../statics';
import AudienceSection from './AudienceSection.astro';

const cards = [
  { title: 'Understand the data model', href: URLS.INTERNAL_DEV_DATA_MODEL, description: 'Explore the administrative, provenance, and semantic context of research data.' },
  { title: 'Explore ARC representations', href: URLS.INTERNAL_DEV_REPRESENTATION, description: 'Connect flexible research workspaces to the ARC RO-Crate publication representation.' },
  { title: 'Build with ARC', href: URLS.INTERNAL_DEV_TOOLSTACK, description: 'Use the libraries and developer tools that support the ARC ecosystem.' },
];
const links = [
  { title: 'FAIR Digital Objects', href: URLS.INTERNAL_DEV_FDO },
  { title: 'Validation', href: URLS.INTERNAL_DEV_VALIDATION },
  { title: 'ARC Data Hub', href: URLS.INTERNAL_DEV_ARC_DATA_HUB },
  { title: 'Versioning', href: URLS.INTERNAL_DEV_VERSIONING },
];
---

<AudienceSection
  id="FOR-THE-RDM-COMMUNITY"
  number="02"
  audience="For RDM specialists & developers"
  heading="A foundation you can build on."
  introduction="Connect research across tools and systems. Understand the model, work with open representations, and integrate ARC into your infrastructure."
  cards={cards}
  links={links}
  soft
/>

