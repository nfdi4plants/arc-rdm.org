---
import { URLS } from '../../statics';
import AudienceSection from './AudienceSection.astro';

const cards = [
  { title: 'Understand the ARC Abstract Model', href: URLS.INTERNAL_DEV_DATA_MODEL, description: 'Explore the shared entities and relationships that realize ARC’s annotation principles.' },
  { title: 'Explore the ARC RDM system', href: URLS.INTERNAL_DEV_REPRESENTATION, description: 'See how workspace and publication space implement the same foundational principles.' },
  { title: 'Build with ISA ARC tools', href: URLS.INTERNAL_DEV_TOOLSTACK, description: 'Use the libraries and transformations of ARC RDM’s reference domain implementation.' },
];
const links = [
  { title: 'FAIR Digital Objects', href: URLS.INTERNAL_DEV_FDO },
  { title: 'Validation', href: URLS.INTERNAL_DEV_VALIDATION },
  { title: 'ARC Data Hub', href: URLS.INTERNAL_DEV_ARC_DATA_HUB },
  { title: 'Versioning', href: URLS.INTERNAL_DEV_VERSIONING },
];
---

<AudienceSection
  id="FOR-THE-RDM-COMMUNITY"
  number="02"
  audience="For RDM specialists & developers"
  heading="A foundation you can build on."
  introduction="Connect research across tools and systems. Understand the model, work with open representations, and integrate ARC into your infrastructure."
  cards={cards}
  links={links}
  soft
/>

