---
import { referenceNavigation, type ReferenceNavigationLink } from '../data/reference';

interface Props {
  links?: ReferenceNavigationLink[];
  currentPath?: string;
  nested?: boolean;
}

const { links = referenceNavigation, currentPath = Astro.url.pathname, nested = false } = Astro.props;
const normalizedPath = `${currentPath.replace(/\/$/, '')}/`;
---

<ul class:list={['reference-tree', { 'reference-tree-nested': nested }]}>
  {links.map((link) => (
    <li>
      <a href={link.href} aria-current={normalizedPath === link.href ? 'page' : undefined}>
        {link.text}
      </a>
      {link.children && (
        <Astro.self links={link.children} currentPath={currentPath} nested />
      )}
    </li>
  ))}
</ul>

<style>
  .reference-tree { list-style: none; margin: 0; padding: 0; }
  .reference-tree li { margin: 0; }
  .reference-tree a { display: block; padding: .4rem .7rem; border-radius: .35rem; color: var(--site-muted); text-decoration: none; font-size: .875rem; line-height: 1.45; }
  .reference-tree a:hover { color: var(--site-primary); background: var(--site-soft); }
  .reference-tree a[aria-current='page'] { color: var(--site-primary); background: var(--site-soft); font-weight: 650; }
  .reference-tree-nested { padding-left: .65rem; margin-left: .7rem; border-left: 1px solid var(--site-border); }
</style>
