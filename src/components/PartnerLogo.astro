---
import type { CollectionEntry } from 'astro:content';

interface Props {
  partner: CollectionEntry<'partners'>;
  href: string;
}
const { partner: { data }, href } = Astro.props;
---

<a class="partner-logo not-prose" href={href} title={data.name}>
  <img src={data.logo} alt={data.name} width="256" height="80" loading="lazy" decoding="async" />
</a>

<style>
  /* Original brand artwork needs a light backing in both site themes. */
  .partner-logo { display: flex; align-items: center; justify-content: center; width: 100%; max-width: 16rem; height: 6rem; padding: .85rem; border: 1px solid var(--site-border); border-radius: .5rem; background: #fff; }
  .partner-logo:hover, .partner-logo:focus-visible { border-color: var(--site-accent); }
  .partner-logo img { width: 100%; height: 100%; margin: 0; object-fit: contain; }
</style>
